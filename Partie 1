int leds[] = {9,10,11,12,13};
int TrigPin = 3;
int EchoPin = 2;
unsigned long timer;

void setup() {
  // put your setup code here, to run once:
  Serial.begin(9600);

  for( int i = 0; i < 6; i ++) {
    pinMode(leds[i], OUTPUT);
  }

  pinMode(2,INPUT);
  pinMode(3,OUTPUT);
  pinMode(4,INPUT);
  pinMode(52,INPUT);
  
  timer = millis();
}

void loop() {
  // put your main code here, to run repeatedly:
int BP_urgence = digitalRead(52);
int Zone = 0;
int TrigPin = 3;
int EchoPin = 2;
unsigned long duree_BP;


digitalWrite(TrigPin,LOW);
delayMicroseconds(2);
digitalWrite(TrigPin,HIGH);
delayMicroseconds(10);
digitalWrite(TrigPin,LOW);

unsigned long duree = pulseIn(EchoPin,HIGH);

float distance = 0.034 * duree / 2;

  if (distance < 5) {
    digitalWrite(leds[0],HIGH);
    digitalWrite(leds[1],LOW);
    digitalWrite(leds[2],LOW);
    digitalWrite(leds[3],LOW);
    digitalWrite(leds[4],LOW);
    Zone = 1;
  }

  if ( distance >= 5 && distance < 10){
    digitalWrite(leds[0],LOW);
    digitalWrite(leds[1],HIGH);
    digitalWrite(leds[2],LOW);
    digitalWrite(leds[3],LOW);
    digitalWrite(leds[4],LOW);
    Zone = 2;   
  }

  if ( distance >= 15 && distance < 15){
  digitalWrite(leds[0],LOW);
  digitalWrite(leds[1],LOW);
  digitalWrite(leds[2],HIGH);
  digitalWrite(leds[3],LOW);
  digitalWrite(leds[4],LOW); 
  Zone = 3;  
  }

  if ( distance >= 15 && distance < 20){
    digitalWrite(leds[0],LOW);
    digitalWrite(leds[1],LOW);
    digitalWrite(leds[2],LOW);
    digitalWrite(leds[3],HIGH);
    digitalWrite(leds[4],LOW); 
    Zone = 4;  
  }

  if (distance > 25){
    digitalWrite(leds[0],LOW);
    digitalWrite(leds[1],LOW);
    digitalWrite(leds[2],LOW);
    digitalWrite(leds[3],LOW);
    digitalWrite(leds[4],HIGH);   
    Zone = 5;
  }

  if((millis()-timer) > 1000){

    timer = millis();

    Serial.print("Zone ");
    Serial.print(Zone);
    Serial.print(" détectée");
    Serial.println();
  }

  if(BP_urgence == HIGH) {
    digitalWrite(TrigPin,LOW);
    digitalWrite(leds[0],HIGH);
    digitalWrite(leds[1],HIGH);
    digitalWrite(leds[2],HIGH);
    digitalWrite(leds[3],HIGH);
    digitalWrite(leds[4],HIGH);
    delay(500);
    digitalWrite(leds[0],LOW);
    digitalWrite(leds[1],LOW);
    digitalWrite(leds[2],LOW);
    digitalWrite(leds[3],LOW);
    digitalWrite(leds[4],LOW);
    delay(500); 
    duree_BP = pulseIn(BP_urgence,HIGH); 
    Serial.print("BP d'urgence appuyé pour  ");
    Serial.print(duree_BP/1000);
    Serial.println("secondes");

  }

}
